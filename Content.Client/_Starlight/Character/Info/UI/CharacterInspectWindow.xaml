<ui:CharacterInspectWindow
    xmlns="https://spacestation14.io"
    xmlns:ui="clr-namespace:Content.Client._Starlight.Character.Info.UI"
    xmlns:kinks="clr-namespace:Content.Client._Serenity.Kinks.UI"
    MinSize="400 545"
>
    <ScrollContainer HScrollEnabled="False">
        <TabContainer Name="InspectTabs" Access="Public">
            <BoxContainer Orientation="Vertical">
                <ui:CharacterICInfoControl Access="Public" Name="ICInfo"/>
            </BoxContainer>
            <BoxContainer Orientation="Vertical">
                <ui:CharacterOOCInfoControl Access="Public" Name="OOCInfo"/>
            </BoxContainer>
            <BoxContainer Orientation="Vertical">
                <ui:CharacterBackgroundInfoControl Access="Public" Name="BackgroundInfo"/>
            </BoxContainer>
            <!-- Serenity: published kink list -->
            <BoxContainer Orientation="Vertical">
                <kinks:CharacterKinksInfoControl Access="Public" Name="KinksInfo"/>
            </BoxContainer>
        </TabContainer>

    </ScrollContainer>
</ui:CharacterInspectWindow>
