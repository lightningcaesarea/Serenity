iv-verb-toggle = Switch injecting / drawing
iv-now-injecting = The line is set to give fluid to the patient.
iv-now-drawing = The line is set to draw blood from the patient.

iv-cannot-self = You can't set a line in yourself.
iv-no-bag = { CAPITALIZE(THE($iv)) } has no bag hung on it.

iv-attach-start-self = You start finding a vein on { THE($target) }.
iv-attach-start-others = { CAPITALIZE(THE($user)) } starts finding a vein on { THE($target) }.
iv-attach-self-injecting = You hook { THE($iv) } to { THE($target) }, giving fluid.
iv-attach-others-injecting = { CAPITALIZE(THE($user)) } hooks { THE($iv) } to { THE($target) }, giving fluid.
iv-attach-self-drawing = You hook { THE($iv) } to { THE($target) }, drawing blood.
iv-attach-others-drawing = { CAPITALIZE(THE($user)) } hooks { THE($iv) } to { THE($target) }, drawing blood.

iv-detach-self = You take { THE($iv) } out of { THE($target) }.
iv-detach-others = { CAPITALIZE(THE($user)) } takes { THE($iv) } out of { THE($target) }.
iv-detach-own-others = { CAPITALIZE(THE($target)) } takes { THE($iv) } out.
iv-rip = The IV line is torn out of { THE($target) }!

iv-examine-injecting = It is set to give fluid to the patient.
iv-examine-drawing = It is set to draw blood from the patient.
iv-examine-stand-bag = { CAPITALIZE(THE($bag)) } hangs on it with { $units } units inside.
iv-examine-stand-empty = Nothing is hung on it.
iv-examine-bag = It holds { $units } units.
iv-examine-attached = It is hooked to { THE($patient) }.
iv-examine-unattached = It is not hooked to anyone.
